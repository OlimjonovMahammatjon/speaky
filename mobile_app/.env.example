# Supabase Configuration for IELTS Speaky Mobile App
# Copy this file to .env and fill in your Supabase project credentials

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: AI Speaking Partner Keys (can also be configured via React Admin Studio)
# 1. Google Gemini API Key
GEMINI_API_KEY=

# 2. Groq API Key (Ultra-fast Whisper Large V3 + LLaMA 3.3)
GROQ_API_KEY=
